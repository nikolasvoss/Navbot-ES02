<?xml version="1.0"?>
<package format="3">
  <name>navbot_link_bridge</name>
  <version>0.1.0</version>
  <description>NavBot ESP32 link bridge: wheel odometry, TF and IMU from the UART protocol.</description>
  <maintainer email="niko@example.invalid">Navbot maintainers</maintainer>
  <license>Unspecified</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
